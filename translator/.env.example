# 复制为 .env 后填写。哪个填了就启用哪个，不填的会在页面上显示为灰色。
# MyMemory 免费引擎不需要密钥，默认开启。

# DeepL（免费版密钥以 :fx 结尾，会自动走 api-free.deepl.com）
DEEPL_API_KEY=

# Google Cloud Translation（Basic v2，在 Google Cloud 控制台创建 API Key）
GOOGLE_API_KEY=

# 微软 Azure Translator（资源不是 global 时需要填区域，如 eastasia）
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Claude（Anthropic API）。默认模型 claude-opus-5-5，翻译用 low effort
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low

# 百度翻译开放平台（通用文本翻译）
BAIDU_APP_ID=
BAIDU_SECRET=

# 有道智云（文本翻译）
YOUDAO_APP_KEY=
YOUDAO_APP_SECRET=

# OpenAI 兼容接口的大模型，最多 5 个（LLM_1_ … LLM_5_）。
# 三项都填才启用；模型名请以对应平台文档为准。
# 示例：
# LLM_1_NAME=DeepSeek
# LLM_1_BASE_URL=https://api.deepseek.com
# LLM_1_API_KEY=
# LLM_1_MODEL=
#
# LLM_2_NAME=通义千问
# LLM_2_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_2_API_KEY=
# LLM_2_MODEL=
#
# LLM_3_NAME=OpenAI
# LLM_3_BASE_URL=https://api.openai.com/v1
# LLM_3_API_KEY=
# LLM_3_MODEL=

# MyMemory：填邮箱可提高每日免费额度；设为 1 可关闭
# MYMEMORY_EMAIL=
# MYMEMORY_DISABLED=0

# 服务监听地址
# PORT=8787
# HOST=127.0.0.1
